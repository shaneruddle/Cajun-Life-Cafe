rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
             : 'none';
    }

    function isAdmin() {
      return isAuthenticated() &&
             (getUserRole() == 'admin' || request.auth.token.role == 'admin');
    }

    function isMarketing() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'marketing');
    }

    function isCashier() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'cashier' || getUserRole() == 'manager');
    }

    function isManager() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'manager');
    }

    function isStaff() {
      return isAuthenticated() && (
        isAdmin() || getUserRole() == 'manager' || getUserRole() == 'cashier' || getUserRole() == 'marketing'
      );
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /menu/{id} {
      allow read: if true;
      allow write: if isMarketing();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isMarketing();
    }
    match /custom_meals/{id} {
      allow read: if true;
      allow write: if isMarketing();
    }
    match /jobs/{id} {
      allow read: if true;
      allow write: if isCashier();
    }
    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isMarketing();
    }
    match /settings/{id} { allow read: if true; }
    match /test/connection { allow read: if true; }

    function isOwnerBootstrap() {
      return request.auth.token.email == 'info@cajunlifecafe.com' &&
             request.auth.token.email_verified == true;
    }

    function isSafeSelfSignup(data) {
      return (data.role == 'employee' &&
              !('salary' in data) && !('ssoDeduction' in data) &&
              !('otHourlyRate' in data) && !('payrollNotes' in data) &&
              !('bankBranch' in data) && !('bankAccountNumber' in data) &&
              !('disabled' in data) && !('pending' in data))
             ||
             (data.role == 'admin' && isOwnerBootstrap());
    }

    function isClaimingOwnPendingProfile(data) {
      let pendingId = data.claimedFromPendingId;
      let pendingPath = /databases/$(database)/documents/users/$(pendingId);
      return pendingId is string &&
             exists(pendingPath) &&
             get(pendingPath).data.pending == true &&
             get(pendingPath).data.email == request.auth.token.email &&
             get(pendingPath).data.role == data.role;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isManager() ||
        (resource.data.pending == true && resource.data.email == request.auth.token.email)
      );

      allow create: if isAuthenticated() && request.auth.uid == userId && (
        isAdmin() ||
        isSafeSelfSignup(request.resource.data) ||
        isClaimingOwnPendingProfile(request.resource.data)
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastLogin', 'displayName', 'email', 'photoURL'])) ||
        (resource.data.pending == true &&
         resource.data.email == request.auth.token.email &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['superseded', 'claimedUid']))
      );
    }

    match /staff_directory/{id} {
      allow read: if isCashier();
      allow write: if isAdmin();
    }

    match /finance_categories/{id} {
      allow read: if isAuthenticated();
    }
    match /finance_entries/{id} {
      allow read: if isAdmin();
      allow create: if isCashier();
    }
    match /finance_expenses/{id} {
      allow read, write: if isCashier();
    }
    match /finance_income/{id} {
      allow read, write: if isCashier();
    }
    match /finance_ingredients/{id} {
      allow read, write: if isCashier();
    }
    match /ingredient_purchases/{id} {
      allow read, write: if isCashier();
    }

    match /daily_balances/{date} {
      allow read: if isCashier();
      allow create: if isCashier();
      allow update: if isCashier() && (!('lockAt' in resource.data) || request.time < resource.data.lockAt);
      allow delete: if false;

      match /history/{id} {
        allow read: if isCashier();
        allow create: if isCashier();
        allow update, delete: if false;
      }
    }

    match /employees/{id} {
      allow read, write: if isAdmin();
    }
    match /payroll_summaries/{id} {
      allow read, write: if isAdmin();
    }
    match /payroll_timecards/{id} {
      allow read, write: if isManager();
    }

    match /calendar_events/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /crm_customers/{id} {
      allow read, write: if isCashier();
      match /transactions/{txId} {
        allow read, write: if isCashier();
      }
    }

    match /activation_tokens/{id} {
      allow read, write: if isCashier();
    }

    match /loyalty_customers/{id} {
      allow read, write: if isCashier();
      match /transactions/{txId} {
        allow read, write: if isCashier();
      }
    }
    match /loyalty_transactions/{id} {
      allow read, write: if isCashier();
    }

    match /system_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
  }
}
