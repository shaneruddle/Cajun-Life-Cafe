rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
             : 'none';
    }

    function isAdmin() {
      return isAuthenticated() &&
             (getUserRole() == 'admin' || request.auth.token.role == 'admin');
    }

    function isMarketing() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'marketing');
    }

    function isCashier() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'cashier' || getUserRole() == 'manager');
    }

    // Admin: Full access to everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Public: Read access to menu and settings
    match /menu/{id} {
      allow read: if true;
      allow write: if isMarketing();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isMarketing();
    }
    match /custom_meals/{id} {
      allow read: if true;
      allow write: if isMarketing();
    }
    // Job postings — public can read (shown on /careers), Admin/Manager (and
    // cashier, incidentally, via isCashier()) can manage them from /dashboard/jobs.
    match /jobs/{id} {
      allow read: if true;
      allow write: if isCashier();
    }
    // Blog posts — public can read (shown on /blog), Admin/Marketing manage
    // them from /dashboard/blog. Same "read: true regardless of status"
    // pattern already used for /menu's `published` flag.
    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isMarketing();
    }
    match /settings/{id} { allow read: if true; }
    match /test/connection { allow read: if true; }

    // Users: Owner or Admin, plus a narrow self-claim path — a freshly
    // authenticated user may read/update an admin-created "pending" profile
    // that matches their own verified email, so a pre-created profile (with
    // role/salary/etc. already set) gets linked to their real account on
    // first login instead of a blank duplicate being created. See
    // src/utils/userClaim.ts. This never lets anyone touch another person's
    // already-claimed profile — only doc(s) still marked pending == true.
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (resource.data.pending == true && resource.data.email == request.auth.token.email)
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (resource.data.pending == true && resource.data.email == request.auth.token.email)
      );
    }

    // Finance
    match /finance_categories/{id} {
      allow read: if isAuthenticated();
    }
    match /finance_entries/{id} {
      allow read: if isAdmin();
      allow create: if isCashier();
    }
    match /finance_expenses/{id} {
      allow read, write: if isCashier();
    }
    match /finance_incomes/{id} {
      allow read, write: if isCashier();
    }
    match /finance_ingredients/{id} {
      allow read, write: if isCashier();
    }
    match /ingredient_purchases/{id} {
      allow read, write: if isCashier();
    }

    match /employees/{id} {
      allow read, write: if isAdmin();
    }
    match /payroll_summaries/{id} {
      allow read, write: if isAdmin();
    }

    // CRM — cashiers can read/write customers and their transaction subcollection
    match /crm_customers/{id} {
      allow read, write: if isCashier();
      match /transactions/{txId} {
        allow read, write: if isCashier();
      }
    }

    // Activation tokens — cashiers create them, server reads them
    match /activation_tokens/{id} {
      allow read, write: if isCashier();
    }

    // Legacy loyalty collections (kept for safety)
    match /loyalty_customers/{id} {
      allow read, write: if isCashier();
      match /transactions/{txId} {
        allow read, write: if isCashier();
      }
    }
    match /loyalty_transactions/{id} {
      allow read, write: if isCashier();
    }

    match /system_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
  }
}
