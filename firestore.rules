rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
             : 'none';
    }

    function isAdmin() {
      return isAuthenticated() && 
             (getUserRole() == 'admin' || 
              request.auth.token.email == "info@cajunlifecafe.com");
    }

    function isMarketing() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'marketing');
    }

    function isCashier() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'cashier');
    }

    // Admin: Full access to everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Public: Read access to menu and settings
    match /menu/{id} { 
      allow read: if true; 
      allow write: if isMarketing();
    }
    match /categories/{id} { 
      allow read: if true; 
      allow write: if isMarketing();
    }
    match /custom_meals/{id} { 
      allow read: if true; 
      allow write: if isMarketing();
    }
    match /settings/{id} { allow read: if true; }
    match /test/connection { allow read: if true; }

    // Users: Owner or Admin
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Finance: Authenticated users can read categories and create entries
    match /finance_categories/{id} {
      allow read: if isAuthenticated();
    }

    match /finance_entries/{id} {
      allow read: if isAdmin();
      allow create: if isCashier();
    }

    match /employees/{id} {
      allow read, write: if isAdmin();
    }

    match /payroll_summaries/{id} {
      allow read, write: if isAdmin();
    }

    match /loyalty_customers/{id} {
      allow read, write: if isAdmin();
      match /transactions/{txId} {
        allow read, write: if isAdmin();
      }
    }

    match /system_logs/{id} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated(); // Allow any staff to log
    }

    // Employees: Only read their own data (handled by users match)
    // Marketing: Handled by isAdmin/isMarketing checks in relevant collections if any
  }
}
