{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "cajun-life-cafe",
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/find_us",
        "destination": "/#location",
        "type": 301
      },
      {
        "source": "/menu",
        "destination": "/digital-menu",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "cajun-life-cafe-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "/activate/callback",
        "run": {
          "serviceId": "cajun-life-cafe-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "/sitemap.xml",
        "run": {
          "serviceId": "cajun-life-cafe-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "/blog/**",
        "run": {
          "serviceId": "cajun-life-cafe-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/menu-items/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
