# Copy this file to .env.local and fill in your real values.
# .env.local is in .gitignore and will NEVER be committed.

# GEMINI_API_KEY: Server-side only (used by /api/ai proxy in server.ts)
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this app is hosted.
APP_URL=your_app_url_here

# Firebase Client-Side Config (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_DATABASE_ID=your_firestore_database_id_here

# Google Maps API Keys
# Server-side key - restrict by server IP in Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key_here
# Client-side key for map embed - restrict by HTTP referrer in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_client_api_key_here

# SMTP Configuration for Contact Form
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here

# LINE LIFF/MINI App ID for the in-chat ordering page (/order) — from the
# LINE Developers Console once the app is registered (see cajun-line-ordering-spec.md)
VITE_LIFF_ID=your_liff_id_here

# Twilio SMS Configuration (server-side only - do NOT use VITE_ prefix)
# Get these from twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid_here
TWILIO_SENDER_ID=your_sender_id_here
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid_here
